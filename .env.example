# Keep the username and database name unchanged unless the healthcheck in
# docker-compose.yml is updated too.
POSTGRES_DB=course_catalog
POSTGRES_USER=catalog_app
POSTGRES_PASSWORD=replace_with_a_long_alphanumeric_password

# Use the same password as POSTGRES_PASSWORD. Keep it alphanumeric so the URL
# does not need percent-encoding.
DATABASE_URL=postgresql+psycopg://catalog_app:replace_with_a_long_alphanumeric_password@database:5432/course_catalog
SQL_ECHO=false
GRAPHQL_INTROSPECTION=false
